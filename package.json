{
  "name": "generaldemos-frontends",
  "private": true,
  "version": "1.0.0",
  "description": "dotCMS demo frontends. One npm workspace so all sites share a single node_modules.",
  "workspaces": [
    "frontend",
    "frontend-spiritvoice",
    "frontend-govconnect",
    "frontend-forgehub",
    "frontend-sandler",
    "frontend-vodafone",
    "frontend-education"
  ],
  "scripts": {
    "dev:bank": "npm run dev -w dotcms-learning-nextjs",
    "dev:spiritvoice": "npm run dev -w spiritvoice-nextjs",
    "dev:govconnect": "npm run dev -w govconnect-nextjs",
    "dev:forgehub": "npm run dev -w forgehub-nextjs",
    "dev:sandler": "npm run dev -w sandler-nextjs",
    "dev:vodafone": "npm run dev -w vodafone-nextjs",
    "dev:education": "npm run dev -w education-nextjs",
    "ios:vodafone": "npm --prefix mobile-vodafone run ios",
    "dev:all": "npm run dev:bank & npm run dev:spiritvoice & npm run dev:govconnect & npm run dev:forgehub & npm run dev:sandler & npm run dev:vodafone & npm run dev:education & wait"
  },
  "dependencies": {
    "@dotcms/client": "26.9.3-1",
    "@dotcms/react": "26.9.3-1",
    "@dotcms/types": "26.9.3-1",
    "@dotcms/uve": "26.9.3-1",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.37",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "knip": "^6.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
