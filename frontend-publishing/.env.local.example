# Written by publishing-demo/setup/09-frontend-env.mjs. Server-side only: the
# token is never sent to the browser (no NEXT_PUBLIC_ prefix).
DOTCMS_URL=https://awesomedemo-dev.dotcms.dev
# Read-only token for the hub service account (Hub Reader role)
DOTCMS_READ_TOKEN=
DOTCMS_SITE_ID=
# Public, used for image and file URLs only
NEXT_PUBLIC_DOTCMS_HOST=https://awesomedemo-dev.dotcms.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3010
