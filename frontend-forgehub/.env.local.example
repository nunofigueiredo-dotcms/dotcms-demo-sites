# Copy to .env.local and fill in the token. .env.local is gitignored.
# Site: forgehub.com
NEXT_PUBLIC_DOTCMS_HOST=http://localhost:8082

# Generate in dotCMS: System > Users > admin > API Access Tokens.
# Use a READ-ONLY token scoped to Pages, Folders, Assets and Content.
NEXT_PUBLIC_DOTCMS_AUTH_TOKEN=

NEXT_PUBLIC_DOTCMS_SITE_ID=3465943d44960cdee2606a7fd248b808
NEXT_PUBLIC_DOTCMS_MODE=development
NEXT_PUBLIC_SITE_URL=http://localhost:3004
