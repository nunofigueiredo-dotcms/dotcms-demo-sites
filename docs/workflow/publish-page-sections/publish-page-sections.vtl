## ─────────────────────────────────────────────────────────────────────────
## Publish page sections — a step on System Workflow → Publish.
##
## In dotCMS, publishing a page publishes the page only; each section on it
## is separate content with its own workflow. When a page is published, this
## also publishes the Vodafone page sections on the page's site that have
## unpublished changes (banners, slides, carousels, tiles, …; not records
## such as plans, stores or subscriptions), through the Vodafone Editorial
## workflow, as the same user — and only for administrators and Vodafone
## Reviewers. Editors publishing a page publish just the page.
##
## Why the whole site, not just this page: a script step can't list a
## page's sections here (the page API needs a login this step can't pass on,
## GraphQL needs POST, and JavaScript steps fail on pages).
## Velocity can't catch errors, so who may publish is checked first.
## __EDITORIAL_PUBLISH__ is filled in by docs/install-publish-page-sections.py.
## ─────────────────────────────────────────────────────────────────────────
#if("$contentlet.getContentType().baseType()" == "HTMLPAGE")
#if($user.isAdmin() || $cmsuser.isUserRole($user, "Vodafone Reviewer"))
#set($sectionTypes = "VodafoneHeroSlide OR VodafoneHeroCarousel OR VodafonePageBanner OR VodafoneQuickLinks OR VodafoneTile OR VodafoneServiceCarousel OR VodafonePlanList OR VodafoneFeatureSplit OR VodafoneFeatureGrid OR VodafoneFaq OR VodafoneStoreLocator")
#set($drafts = $dotcontent.pull("+conHost:${contentlet.getHost()} +working:true +live:false +deleted:false +contentType:(${sectionTypes})", 200, "modDate desc"))
#foreach($draft in $drafts)
  #set($section = $draft.contentObject)
  #if(!$section.isArchived())
    #set($ok = $workflowtool.fire({"identifier": $section.identifier, "contentType": "$section.contentType.variable()", "languageId": $section.languageId}, "__EDITORIAL_PUBLISH__"))
  #end
#end
#end
#end
