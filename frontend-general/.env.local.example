# Copy to .env.local and fill in the token. .env.local is gitignored.
# Site: general.com on awesomedemo-dev (the Expo City Dubai demo).
NEXT_PUBLIC_DOTCMS_HOST=https://awesomedemo-dev.dotcms.dev

# Generate in awesomedemo-dev: System > Users > (your user) > API Access Tokens.
NEXT_PUBLIC_DOTCMS_AUTH_TOKEN=

NEXT_PUBLIC_DOTCMS_SITE_ID=2fea4d74f8708e989ace7c9df528de8f
# The instance's Arabic (ar-AE) language. /ar/... pages are asked for in it.
NEXT_PUBLIC_DOTCMS_ARABIC_LANGUAGE_ID=4756217
NEXT_PUBLIC_DOTCMS_MODE=development
NEXT_PUBLIC_SITE_URL=http://localhost:3009

# dotCMS Content Analytics: the site key printed by docs/build-general.py.
# Events are recorded only when the site is opened as
# http://general.localhost:3009 (a site alias), not localhost:3009.
NEXT_PUBLIC_DOTCMS_ANALYTICS_SITE_KEY=
NEXT_PUBLIC_DOTCMS_ANALYTICS_DEBUG=false
