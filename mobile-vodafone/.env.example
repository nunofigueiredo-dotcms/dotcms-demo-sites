# Copy to .env.local and fill in the token. .env.local is gitignored.
# Expo inlines EXPO_PUBLIC_* values into the app bundle, so use a token that
# can only read content (a limited user), not an admin token, for anything
# beyond the simulator.
EXPO_PUBLIC_DOTCMS_HOST=https://awesomedemo-dev.dotcms.dev
EXPO_PUBLIC_DOTCMS_AUTH_TOKEN=
# telcodemo.com
EXPO_PUBLIC_DOTCMS_SITE_ID=c81fca370b6afed12062f71739234638
