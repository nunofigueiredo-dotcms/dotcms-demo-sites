# Copy to .env.local and fill in the token. .env.local is gitignored.
# Site: trainning-service.com on awesomedemo-dev (the Sandler demo).
NEXT_PUBLIC_DOTCMS_HOST=https://awesomedemo-dev.dotcms.dev

# Generate in awesomedemo-dev: System > Users > (your user) > API Access Tokens.
NEXT_PUBLIC_DOTCMS_AUTH_TOKEN=

NEXT_PUBLIC_DOTCMS_SITE_ID=2ad84b4176441e1b1a6ef8d2e683a79e
NEXT_PUBLIC_DOTCMS_MODE=development
NEXT_PUBLIC_SITE_URL=http://localhost:3006

# To run against the local Docker stack instead (site sandler.com):
#   NEXT_PUBLIC_DOTCMS_HOST=http://localhost:8082
#   NEXT_PUBLIC_DOTCMS_SITE_ID=e817e9c8f1c76b29940ee10be7ebb224
#   plus a token from the local instance.
