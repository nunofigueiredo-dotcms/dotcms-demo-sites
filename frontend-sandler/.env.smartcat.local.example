# Copy to .env.smartcat.local (gitignored) for `npm run smartcat`.
# Smartcat: Settings > API — "Account ID" and a key from "Create new key".
SMARTCAT_ACCOUNT_ID=
SMARTCAT_API_KEY=
# API host for your account's region: https://smartcat.ai (Europe),
# https://us.smartcat.ai (America) or https://ea.smartcat.ai (Asia).
# The web-app host (smartcat.com / us.smartcat.com) also works.
SMARTCAT_SERVER=https://us.smartcat.ai
# Smartcat language codes; each needs a matching language in dotCMS.
SMARTCAT_TARGETS=es,fr
