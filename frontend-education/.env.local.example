# Copy to .env.local and fill in the token. .env.local is gitignored.
# Site: educationdemo.com on awesomedemo-dev (the Texas School for the Deaf demo).
NEXT_PUBLIC_DOTCMS_HOST=https://awesomedemo-dev.dotcms.dev

# Generate in awesomedemo-dev: System > Users > (your user) > API Access Tokens.
NEXT_PUBLIC_DOTCMS_AUTH_TOKEN=

NEXT_PUBLIC_DOTCMS_SITE_ID=5875220ead521d2fe31cedd1aad6b594
NEXT_PUBLIC_DOTCMS_MODE=development
NEXT_PUBLIC_SITE_URL=http://localhost:3008

# dotCMS Content Analytics: the site key from the Content Analytics app on
# educationdemo.com (printed by docs/build-education.py). Public, like a GA ID.
# Events are recorded only when the site is opened as
# http://educationdemo.localhost:3008 (a site alias), not localhost:3008.
NEXT_PUBLIC_DOTCMS_ANALYTICS_SITE_KEY=
NEXT_PUBLIC_DOTCMS_ANALYTICS_DEBUG=false
